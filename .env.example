# PDF.js worker URL (local + prod). Use your S3 public URL for pdf.worker.min.mjs.
VITE_PDF_WORKER_URL=

# Google Analytics 4 - Measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics. Only used when set.
VITE_GA_MEASUREMENT_ID=

# Supabase - for compression metrics. Leave empty to disable (no-op service).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AdSense - Publisher ID (must match script in index.html). Leave empty to hide ads.
VITE_ADSENSE_CLIENT_ID=ca-pub-7692014257759117
# Ad unit slot IDs from AdSense (one per placement). Create ad units in AdSense and paste IDs here.
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_COMPRESSION=
